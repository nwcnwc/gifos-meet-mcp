# One self-update round for a guard bot (scripts/self-update.sh; docs/recipes/self-update.md), started by
# gifos-meet-guard-update.timer. Settings (all optional) go in ~/.config/gifos-guard/update.env, e.g. PATH for a node
# that is not on the default PATH, or GIFOS_UPDATE_SOAK_MIN. Logs: journalctl --user -u gifos-meet-guard-update
[Unit]
Description=GifOS Meet guard bot self-update (one round)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/gifos-guard/update.env
# A round that died mid-swap may have left the live checkout moved aside: run the updater from whichever tree has it
# (the live one first); that round puts the protected commit back.
ExecStart=/bin/sh -c 'for d in %h/gifos-meet-mcp %h/gifos-meet-mcp.prev.tmp %h/gifos-meet-mcp.prev %h/gifos-meet-mcp.next; do [ -x "$$d/scripts/self-update.sh" ] && exec "$$d/scripts/self-update.sh"; done; echo "self-update: no checkout holds scripts/self-update.sh"; exit 1'
# The round bounds its own waits (GIFOS_UPDATE_REJOIN_SEC); no wall-clock kill on a build that is making progress.
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=idle
# The build (npm ci, npm test) needs about 1 GB beside the bot: under memory pressure it is reclaimed and, if it
# comes to that, killed first, never the bot.
MemoryHigh=800M
OOMScoreAdjust=800
