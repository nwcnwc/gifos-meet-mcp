{
  "mcpServers": {
    "gifos-meet": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "npm@11.6.2",
        "exec",
        "-y",
        "--",
        "github:nwcnwc/gifos-meet-mcp#bd305bec441651d9d0bd71bb5a48006b41ddb07e"
      ],
      "env": {
        "npm_config_ignore_scripts": "true",
        "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip",
        "GIFOS_URL": "https://gifos.app"
      }
    }
  }
}
