{
  "mcpServers": {
    "gifos-meet": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "npm@11.6.2",
        "exec",
        "-y",
        "--",
        "github:nwcnwc/gifos-meet-mcp#8e4f3c99b560de2b5aabee0d14f7e7f446c5a2cc"
      ],
      "env": {
        "npm_config_ignore_scripts": "true",
        "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip",
        "GIFOS_URL": "https://gifos.app"
      }
    }
  }
}
