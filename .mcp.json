{
  "mcpServers": {
    "gifos-meet": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "npm@11.6.2",
        "exec",
        "-y",
        "--",
        "github:nwcnwc/gifos-meet-mcp#c65a36b66d40e935be25e1c083a274d08184e1e5"
      ],
      "env": {
        "npm_config_ignore_scripts": "true",
        "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip",
        "GIFOS_URL": "https://gifos.app"
      }
    }
  }
}
